generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model resumos {
  id         Int         @id @default(autoincrement())
  titulo     String      @db.VarChar(100)
  materia    String      @db.VarChar(50)
  conteudo   String
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  pdf_name   String      @default("seu_pdf.pdf") @db.VarChar(100)
  user_id    Int
  mensagens  mensagens[]
  usuarios   usuarios    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model usuarios {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  email      String    @unique @db.VarChar(250)
  senha_hash String    @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  resumos    resumos[]
}

model mensagens {
  id         Int       @id @default(autoincrement())
  role       String    @db.VarChar(10)
  content    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  resumo_id  Int
  resumos    resumos   @relation(fields: [resumo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
